{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and role in the EBD management system",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "role": {
          "type": "string",
          "enum": ["MASTER", "DIRIGENTE", "SECRETARIA", "TESOURARIA", "PENDING"]
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Transaction": {
      "title": "Financial Transaction",
      "description": "Financial entry or exit record for EBD cash accounts",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["income", "expense"] },
        "account": { "type": "string", "enum": ["caixa_5", "caixa_licoes"] },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 32 },
        "description": { "type": "string", "maxLength": 500 },
        "receiptUrl": { "type": "string", "maxLength": 1000 },
        "receiptName": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 128 },
        "createdByEmail": { "type": "string", "maxLength": 256 },
        "approvedByUid": { "type": "string", "maxLength": 128 },
        "approvedByName": { "type": "string", "maxLength": 128 },
        "approvedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" },
        "lessonOrderId": { "type": "string", "maxLength": 128 }
      },
      "required": ["type", "account", "amount", "date", "description", "status", "createdByUid", "createdByEmail", "createdAt"]
    },
    "LessonOrder": {
      "title": "EBD Lesson Order",
      "description": "Orders and status of Sunday School lesson magazines",
      "type": "object",
      "properties": {
        "lessonType": { "type": "string", "enum": ["Adulto", "Aluno", "Jovens", "Infantil", "Outro"] },
        "className": { "type": "string", "maxLength": 128 },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["pago", "nao_pago"] },
        "deliveryStatus": { "type": "string", "enum": ["retirado", "nao_retirado"] },
        "requestedAt": { "type": "string", "maxLength": 64 },
        "paidAt": { "type": "string", "maxLength": 64 },
        "deliveredAt": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["lessonType", "className", "quantity", "paymentStatus", "deliveryStatus", "requestedAt", "createdByUid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and permissions"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transactions for Caixa 5% and Caixa de Lições"
    },
    "/lessonOrders/{orderId}": {
      "schema": "LessonOrder",
      "description": "Sunday School lesson distribution and payment status"
    }
  }
}
